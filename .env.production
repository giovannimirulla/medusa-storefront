# Production Environment Variables for Vercel
# Copy these to Vercel's Environment Variables section

# Backend URL (Render) - for server-side API calls
MEDUSA_BACKEND_URL=https://medusa-backend-6uxo.onrender.com

# Backend URL (Render) - for client-side API calls (autocomplete, etc.)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-backend-6uxo.onrender.com

# Publishable Key (from backend)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_8ec154905f99bd8ae0019415203b91c18c097c1d536a76da4b5f94c7da03d185

# Store URL (update after first deploy with actual Vercel URL)
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Default region
NEXT_PUBLIC_DEFAULT_REGION=it

# Revalidation secret
REVALIDATE_SECRET=supersecret

# Optional: Stripe public key
NEXT_PUBLIC_STRIPE_KEY=

# Optional: Medusa payments (if using)
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional: Medusa Cloud S3 (if using)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
